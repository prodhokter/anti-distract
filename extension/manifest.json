{
  "manifest_version": 3,
  "name": "AntiDistract Blocker",
  "version": "2.1.0",
  "description": "Smart distraction blocker terintegrasi dengan AntiDistract app",
  "permissions": ["tabs", "webNavigation", "storage", "notifications", "alarms", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "AntiDistract"
  },
  "commands": {
    "start-focus": {
      "suggested_key": { "default": "Ctrl+Shift+F" },
      "description": "Mulai sesi Fokus 25 menit"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Ctrl+Shift+P" },
      "description": "Pause/Resume sesi fokus"
    },
    "toggle-blocking": {
      "suggested_key": { "default": "Ctrl+Shift+B" },
      "description": "Toggle pemblokiran situs"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
